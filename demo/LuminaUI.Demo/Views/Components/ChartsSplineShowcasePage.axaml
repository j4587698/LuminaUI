<lumina:LuminaPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:LuminaUI.Localization;assembly=LuminaUI"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:charts="using:LuminaUI.Charts"
             xmlns:vm="using:LuminaUI.Demo.ViewModels"
             x:Class="LuminaUI.Demo.Views.ChartsSplineShowcasePage"
             x:DataType="vm:ChartsSplineShowcaseViewModel">

    <ScrollViewer x:Name="PageScroll"
                  BringIntoViewOnFocusChange="False"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14"
                    Width="{Binding #PageScroll.Bounds.Width}"
                    HorizontalAlignment="Stretch"
                    Margin="0,4,0,24">

            <StackPanel Spacing="6">
                <TextBlock Text="{l10n:Loc Sandbox.Charts.SplineTitle}" Classes="Display" />
                <TextBlock Text="{l10n:Loc Sandbox.Charts.SplineSubtitle}"
                           Foreground="{DynamicResource LuminaTextMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <lumina:LuminaCard Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Loc Sandbox.Charts.SplineCardTitle}" Classes="SectionTitle" />
                    <charts:LuminaLineChart Series="{Binding SplineSeries}"
                                            Height="320"
                                            ShowLegend="True"
                                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </lumina:LuminaCard>
        </StackPanel>
    </ScrollViewer>
</lumina:LuminaPage>