<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LuminaUI.Markdown</PackageId>
    <Description>Lumina-themed Markdown document renderer for Avalonia and LuminaUI.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Parsing only. The AST is mapped onto Lumina controls here, so no Markdown UI package is pulled in. -->
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LuminaUI\LuminaUI.csproj" />
  </ItemGroup>

</Project>
