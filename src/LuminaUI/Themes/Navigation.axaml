<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI">

    <Thickness x:Key="LuminaNavigationItemHeaderBorderThickness">0</Thickness>
    <CornerRadius x:Key="LuminaNavigationItemHeaderCornerRadius">8</CornerRadius>
    <Thickness x:Key="LuminaNavigationItemHeaderPadding">10,7</Thickness>
    <x:Double x:Key="LuminaNavigationItemHeaderColumnSpacing">10</x:Double>
    <x:Double x:Key="LuminaNavigationItemIndicatorWidth">0</x:Double>
    <CornerRadius x:Key="LuminaNavigationItemIndicatorCornerRadius">0</CornerRadius>
    <x:Double x:Key="LuminaNavigationItemIndicatorCollapsedOpacity">0</x:Double>
    <x:Double x:Key="LuminaNavigationItemIndicatorFocusOpacity">0</x:Double>
    <x:Double x:Key="LuminaNavigationItemIndicatorSelectedOpacity">0</x:Double>
    <x:Double x:Key="LuminaNavigationItemIconWidth">20</x:Double>
    <x:Double x:Key="LuminaNavigationItemFontSize">14</x:Double>
    <x:Double x:Key="LuminaNavigationItemChevronSize">14</x:Double>
    <x:Double x:Key="LuminaNavigationItemChevronCollapsedOpacity">0</x:Double>
    <x:Double x:Key="LuminaNavigationItemChevronVisibleOpacity">0.65</x:Double>
    <x:Double x:Key="LuminaNavigationItemItemsContainerCollapsedHeight">0</x:Double>
    <x:Double x:Key="LuminaNavigationItemItemsContainerCollapsedOpacity">0</x:Double>
    <Thickness x:Key="LuminaNavigationItemItemsPresenterMargin">18,2,0,2</Thickness>
    <Thickness x:Key="LuminaNavigationItemCompactPadding">6,8</Thickness>
    <Thickness x:Key="LuminaNavigationItemChildPadding">8,6</Thickness>
    <x:Double x:Key="LuminaNavigationItemChildFontSize">14</x:Double>
    <Thickness x:Key="LuminaNavigationItemDenseHeaderPadding">8,4</Thickness>
    <Thickness x:Key="LuminaNavigationItemDenseChildPadding">6,3</Thickness>
    <x:Double x:Key="LuminaNavigationItemDenseFontSize">13</x:Double>
    <x:Double x:Key="LuminaNavigationItemDenseChildFontSize">12</x:Double>
    <x:Double x:Key="LuminaNavigationItemDenseIconWidth">16</x:Double>
    <Thickness x:Key="LuminaContentPagePadding">0</Thickness>
    <Thickness x:Key="LuminaContentPageHeaderMargin">0,0,0,16</Thickness>
    <x:Double x:Key="LuminaContentPageHeaderFontSize">28</x:Double>

    <ControlTheme x:Key="{x:Type lumina:LuminaNavigationItem}" TargetType="lumina:LuminaNavigationItem">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <Border Name="PART_Header"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="{DynamicResource LuminaNavigationItemHeaderBorderThickness}"
                            CornerRadius="{DynamicResource LuminaNavigationItemHeaderCornerRadius}"
                            Padding="{DynamicResource LuminaNavigationItemHeaderPadding}"
                            ToolTip.Tip="{TemplateBinding Header}"
                            Cursor="Hand">
                        <Grid>
                            <Grid Name="PART_HeaderLayout"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="{DynamicResource LuminaNavigationItemHeaderColumnSpacing}">
                                <Border Name="PART_Indicator"
                                        Grid.Column="0"
                                        Width="0"
                                        IsVisible="False" />

                                <ContentPresenter Name="PART_IconPresenter"
                                                  Grid.Column="0"
                                                  Width="{DynamicResource LuminaNavigationItemIconWidth}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Icon}"
                                                  ContentTemplate="{TemplateBinding IconTemplate}"
                                                  TextElement.FontSize="{DynamicResource LuminaNavigationItemFontSize}"
                                                  TextElement.Foreground="{DynamicResource LuminaTextSecondaryBrush}" />

                                <ContentPresenter Name="PART_HeaderPresenter"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  TextElement.FontSize="{DynamicResource LuminaNavigationItemFontSize}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{DynamicResource LuminaTextPrimaryBrush}" />

                                <PathIcon Name="PART_Chevron"
                                          Grid.Column="2"
                                          IsVisible="False"
                                          Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                          Width="{DynamicResource LuminaNavigationItemChevronSize}"
                                          Height="{DynamicResource LuminaNavigationItemChevronSize}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource LuminaTextTertiaryBrush}"
                                          Opacity="{DynamicResource LuminaNavigationItemChevronVisibleOpacity}"
                                          RenderTransformOrigin="50%,50%">
                                    <PathIcon.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </PathIcon.Transitions>
                                </PathIcon>
                            </Grid>

                            <ContentPresenter Name="PART_CompactIconPresenter"
                                              IsVisible="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Icon}"
                                              ContentTemplate="{TemplateBinding IconTemplate}"
                                              TextElement.FontSize="{DynamicResource LuminaNavigationItemFontSize}"
                                              TextElement.Foreground="{DynamicResource LuminaTextSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <Border Name="PART_ItemsContainer"
                            Height="{DynamicResource LuminaNavigationItemItemsContainerCollapsedHeight}"
                            Opacity="{DynamicResource LuminaNavigationItemItemsContainerCollapsedOpacity}"
                            ClipToBounds="True"
                            IsVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Height" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                        <ItemsPresenter Name="PART_ItemsPresenter" Margin="{DynamicResource LuminaNavigationItemItemsPresenterMargin}" />
                    </Border>
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_Header">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Hover State -->
        <Style Selector="^:headerpointerover /template/ Border#PART_Header">
            <Setter Property="Background" Value="{DynamicResource LuminaStateHoverBrush}" />
        </Style>

        <Style Selector="^:headerpointerover /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource LuminaTextPrimaryBrush}" />
        </Style>

        <Style Selector="^:headerpointerover /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource LuminaTextPrimaryBrush}" />
        </Style>

        <Style Selector="^:headerpointerover /template/ PathIcon#PART_Chevron">
            <Setter Property="Foreground" Value="{DynamicResource LuminaTextPrimaryBrush}" />
        </Style>

        <!-- Focus State -->
        <Style Selector="^:focus-visible /template/ Border#PART_Header">
            <Setter Property="BorderBrush" Value="{DynamicResource LuminaBorderFocusBrush}" />
        </Style>

        <!-- Selected State -->
        <Style Selector="^:selected /template/ Border#PART_Header">
            <Setter Property="Background" Value="{DynamicResource LuminaNavigationPaneItemSelectedBrush}" />
        </Style>

        <Style Selector="^:selected:headerpointerover /template/ Border#PART_Header">
            <Setter Property="Background" Value="{DynamicResource LuminaNavigationPaneItemSelectedBrush}" />
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource LuminaNavigationPaneItemSelectedForegroundBrush}" />
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter#PART_CompactIconPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource LuminaNavigationPaneItemSelectedForegroundBrush}" />
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource LuminaNavigationPaneItemSelectedForegroundBrush}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="^:hasitems /template/ PathIcon#PART_Chevron">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="{DynamicResource LuminaNavigationItemChevronVisibleOpacity}" />
        </Style>

        <Style Selector="^ /template/ PathIcon#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>

        <Style Selector="^:expanded /template/ PathIcon#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>

        <Style Selector="^:compact /template/ Border#PART_Header">
            <Setter Property="Padding" Value="{DynamicResource LuminaNavigationItemCompactPadding}" />
            <Setter Property="ToolTip.Tip" Value="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>

        <Style Selector="^:compact /template/ Grid#PART_HeaderLayout">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:compact /template/ ContentPresenter#PART_CompactIconPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Child Items (Hierarchical Tree) -->
        <Style Selector="^.Child /template/ Border#PART_Header, ^:child /template/ Border#PART_Header">
            <Setter Property="Padding" Value="{DynamicResource LuminaNavigationItemChildPadding}" />
        </Style>

        <Style Selector="^.Child /template/ ContentPresenter#PART_HeaderPresenter, ^:child /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="TextElement.FontSize" Value="{DynamicResource LuminaNavigationItemChildFontSize}" />
            <Setter Property="TextElement.FontWeight" Value="Medium" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource LuminaTextPrimaryBrush}" />
        </Style>

        <Style Selector="^.Child /template/ ContentPresenter#PART_IconPresenter, ^:child /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="Width" Value="18" />
        </Style>

        <Style Selector="^.Child:selected /template/ ContentPresenter#PART_HeaderPresenter, ^:child:selected /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource LuminaNavigationPaneItemSelectedForegroundBrush}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>

        <!-- Density Support -->
        <Style Selector="^.Dense /template/ Border#PART_Header, ^:dense /template/ Border#PART_Header">
            <Setter Property="Padding" Value="{DynamicResource LuminaNavigationItemDenseHeaderPadding}" />
        </Style>

        <Style Selector="^.Dense /template/ ContentPresenter#PART_HeaderPresenter, ^:dense /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="TextElement.FontSize" Value="{DynamicResource LuminaNavigationItemDenseFontSize}" />
        </Style>

        <Style Selector="^.Dense /template/ ContentPresenter#PART_IconPresenter, ^:dense /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="Width" Value="{DynamicResource LuminaNavigationItemDenseIconWidth}" />
        </Style>

        <Style Selector="^.Dense.Child /template/ Border#PART_Header, ^:dense:child /template/ Border#PART_Header, ^:dense.Child /template/ Border#PART_Header">
            <Setter Property="Padding" Value="{DynamicResource LuminaNavigationItemDenseChildPadding}" />
        </Style>

        <Style Selector="^.Dense.Child /template/ ContentPresenter#PART_HeaderPresenter, ^:dense:child /template/ ContentPresenter#PART_HeaderPresenter, ^:dense.Child /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="TextElement.FontSize" Value="{DynamicResource LuminaNavigationItemDenseChildFontSize}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ContentPage}" TargetType="ContentPage">
        <Setter Property="Padding" Value="{DynamicResource LuminaContentPagePadding}" />
        <Setter Property="Background" Value="{DynamicResource LuminaBackgroundBrush}" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Header Area -->
                        <Border Grid.Row="0" 
                                Margin="{DynamicResource LuminaContentPageHeaderMargin}"
                                IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter Content="{TemplateBinding Header}" 
                                              TextElement.FontSize="{DynamicResource LuminaContentPageHeaderFontSize}"
                                              TextElement.FontWeight="Bold"
                                              TextElement.Foreground="{DynamicResource LuminaTextForegroundBrush}" />
                        </Border>

                        <!-- Main Content -->
                        <ContentPresenter Grid.Row="1"
                                          Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>

