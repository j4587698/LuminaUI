<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Global Sizing & Density Tokens -->
    <x:Double x:Key="LuminaControlHeightSmall">28</x:Double>
    <x:Double x:Key="LuminaControlHeightDefault">36</x:Double>
    <x:Double x:Key="LuminaControlHeightLarge">48</x:Double>

    <Thickness x:Key="LuminaControlPaddingSmall">8,4</Thickness>
    <Thickness x:Key="LuminaControlPaddingDefault">16,8</Thickness>
    <Thickness x:Key="LuminaControlPaddingLarge">24,12</Thickness>

    <CornerRadius x:Key="LuminaCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="LuminaCornerRadiusDefault">6</CornerRadius>
    <CornerRadius x:Key="LuminaCornerRadiusLarge">8</CornerRadius>

    <x:Double x:Key="LuminaFontSizeSmall">12</x:Double>
    <x:Double x:Key="LuminaFontSizeDefault">14</x:Double>
    <x:Double x:Key="LuminaFontSizeLarge">16</x:Double>

    <x:Double x:Key="LuminaFormItemSpacingSmall">8</x:Double>
    <x:Double x:Key="LuminaFormItemSpacingDefault">16</x:Double>
    <x:Double x:Key="LuminaFormItemSpacingLarge">24</x:Double>

</ResourceDictionary>