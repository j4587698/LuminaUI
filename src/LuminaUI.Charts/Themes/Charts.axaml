<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luminaCharts="using:LuminaUI.Charts">
  <!--
    Charts use the Lumina semantic brushes directly. Those live in the Light/Dark theme
    dictionaries and are overridden at application level by LuminaThemeManager's accent palette,
    so a DynamicResource lookup from the chart follows both the chart's own ThemeVariantScope and
    the current accent. (Chart-specific brushes defined here with Color="{DynamicResource ...}"
    were resolved once against the application variant, so charts inside a dark scope of a light
    app stayed light.)

    The series palette (LuminaChartColor1..8), the marker surface (LuminaChartSurfaceBrush) and
    the tooltip outline (LuminaChartTooltipBorderBrush) are looked up from code: define any of
    those keys to override them, otherwise they fall back to the matching Lumina brush.
  -->
  <Style Selector="luminaCharts|LuminaLineChart">
    <Setter Property="GridLineBrush" Value="{DynamicResource LuminaDividerBrush}" />
    <Setter Property="AxisLabelBrush" Value="{DynamicResource LuminaTextMutedBrush}" />
    <Setter Property="CrosshairBrush" Value="{DynamicResource LuminaTextMutedBrush}" />
    <Setter Property="TooltipBackgroundBrush" Value="{DynamicResource LuminaSurfaceElevatedBrush}" />
    <Setter Property="TooltipTextBrush" Value="{DynamicResource LuminaTextPrimaryBrush}" />
    <Setter Property="LegendTextBrush" Value="{DynamicResource LuminaTextMutedBrush}" />
  </Style>

  <Style Selector="luminaCharts|LuminaPieChart">
    <Setter Property="TooltipBackgroundBrush" Value="{DynamicResource LuminaSurfaceElevatedBrush}" />
    <Setter Property="TooltipTextBrush" Value="{DynamicResource LuminaTextPrimaryBrush}" />
    <Setter Property="LegendTextBrush" Value="{DynamicResource LuminaTextMutedBrush}" />
  </Style>

  <Style Selector="luminaCharts|LuminaRadarChart">
    <Setter Property="GridLineBrush" Value="{DynamicResource LuminaDividerBrush}" />
    <Setter Property="AxisLabelBrush" Value="{DynamicResource LuminaTextMutedBrush}" />
    <Setter Property="TooltipBackgroundBrush" Value="{DynamicResource LuminaSurfaceElevatedBrush}" />
    <Setter Property="TooltipTextBrush" Value="{DynamicResource LuminaTextPrimaryBrush}" />
    <Setter Property="LegendTextBrush" Value="{DynamicResource LuminaTextMutedBrush}" />
  </Style>
</Styles>
